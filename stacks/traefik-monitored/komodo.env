################################################################
# .env
# When both env_file and environment are set for a service, values set by environment have precedence.
# https://docs.docker.com/compose/environment-variables/envvars-precedence/
#
# CANNOT MIX ARRAYS (KEY: VAL) AND MAPS (KEY=VAL)
# Ex: Cannot have .ENV var as TZ=US and then a var here as DB_ENGINE: sqlite, has to be DB_ENGINE=sqlite
# Otherwise unexpected type map[string]interface {} occurs
# https://github.com/docker/compose/issues/11567
#
################################################################

#= Project Specific Settings
## Name of the project stack
PROJECT_NAME: 
## Hostname of server stack runs on
SERVER_NAME: 
## Include a trailing "." if SUB_DOMAIN_NAME field is used. (e.g. "cloud.")
SUB_DOMAIN_NAME: 
## Include domain and TLD. (e.g. "example.com")
DOMAIN_NAME: 

#= Stack Specific Settings
#== Traefik
TRAEFIK_IMAGE: traefik
TRAEFIK_VERSION: [[GLOBAL_TRAEFIK_VERSION]]
TRAEFIK_HOSTNAME: traefik
TRAEFIK_EXTRA_COMMAND:  
PROXY_NETWORK: [[GLOBAL_PROXY_NETWORK]]
## CloudFlare
CF_API_EMAIL: [[CF_API_EMAIL]]
CF_DNS_API_TOKEN: [[CF_DNS_API_TOKEN]]
## Crowdsec
CROWDSEC_LAPI_KEY: 
CROWDSEC_LAPI_HOST: [[GLOBAL_CROWDSEC_LAPI_HOST]]

#== Error-Pages
ERROR_PAGES_IMAGE: tarampampam/error-pages
ERROR_PAGES_VERSION: [[GLOBAL_ERROR_PAGES_VERSION]]
ERROR_PAGES_HOSTNAME: error-pages

#== Socket-Proxy
SOCKET_PROXY_IMAGE: lscr.io/linuxserver/socket-proxy
SOCKET_PROXY_VERSION: [[GLOBAL_SOCKET_PROXY_VERSION]]
SOCKET_PROXY_HOSTNAME: socket-proxy

#== Logrotate
LOGROTATE_IMAGE: vegardit/traefik-logrotate
LOGROTATE_VERSION: [[GLOBAL_LOGROTATE_VERSION]]
LOGROTATE_HOSTNAME: logrotate

#== VMAgent
VMAGENT_IMAGE: victoriametrics/vmagent
VMAGENT_VERSION: [[GLOBAL_VMAGENT_VERSION]]
VMAGENT_HOSTNAME: vmagent
VMAGENT_DISK_USAGE: [[GLOBAL_VMAGENT_DISK_USAGE]]

#== VMAuth
VMAUTH_USER: [[GLOBAL_VMAUTH_USER]]
VMAUTH_PASS: [[GLOBAL_VMAUTH_PASS]]
VMAUTH_HOST: [[GLOBAL_VMAUTH_HOST]]

#== VLAgent
VLAGENT_IMAGE: victoriametrics/vlagent
VLAGENT_VERSION: [[GLOBAL_VLAGENT_VERSION]]
VLAGENT_HOSTNAME: vlagent
VLAGENT_DISK_USAGE: [[GLOBAL_VLAGENT_DISK_USAGE]]

#== vector
VECTOR_IMAGE: docker.io/timberio/vector
VECTOR_VERSION: [[GLOBAL_VECTOR_VERSION]]
VECTOR_HOSTNAME: vector

#= Global Settings
#== Environment Settings
PUID: [[GLOBAL_PUID]]
PGID: [[GLOBAL_PGID]]
TZ: [[GLOBAL_TZ]]
DOCKER_VOLUMES: [[GLOBAL_DOCKER_VOLUMES]]
DOCKER_LOGS: [[GLOBAL_DOCKER_LOGS]]

#== Resouce Limits
MEM_LIMIT: [[GLOBAL_MEM_LIMIT]]
MEM_SWAP_LIMIT: [[GLOBAL_MEM_SWAP_LIMIT]]
MEM_RESERVATION: [[GLOBAL_MEM_RESERVATION]]
PIDS_LIMIT: [[GLOBAL_PIDS_LIMIT]]
CPUS_LIMIT: [[GLOBAL_CPUS_LIMIT]]

#== Running Settings
RESTART_GRACE: [[GLOBAL_RESTART_GRACE]]
RESTART_MODE: [[GLOBAL_RESTART_MODE]]

#== Logging Settings
LOG_MAX_SIZE: [[GLOBAL_LOG_MAX_SIZE]]
LOG_MAX_FILE: [[GLOBAL_LOG_MAX_FILE]]

#== Health Check Settings
HEALTH_INTERVAL: [[GLOBAL_HEALTH_INTERVAL]]
HEALTH_TIMEOUT: [[GLOBAL_HEALTH_TIMEOUT]]
HEALTH_RETRIES: [[GLOBAL_HEALTH_RETRIES]]
HEALTH_START: [[GLOBAL_HEALTH_START]]
