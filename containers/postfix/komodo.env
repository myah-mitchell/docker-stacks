#= Stack Specific Settings
#== Postfix
POSTFIX_HOSTNAME: postfix
POSTFIX_SMTP_PORT: 25
## Where Postfix hands mail on to, such as [smtp.example.net]:587. The square
## brackets skip the MX lookup. Blank delivers straight to each recipient's
## mail server, which most providers junk or refuse from a home address.
POSTFIX_RELAYHOST: 
POSTFIX_RELAYHOST_USERNAME: 
## Issued by the relay provider. Clear to blank when the relay needs no login.
POSTFIX_RELAYHOST_PASSWORD: [[POSTFIX_RELAYHOST_PASSWORD]]
## Space-separated From domains Postfix relays for, matched exactly, so list a
## sub-domain on its own. Blank means DOMAIN_NAME.
POSTFIX_ALLOWED_SENDER_DOMAINS: 
