#= Stack Specific Settings
#== Postgres Backup
POSTGRES_BACKUP_HOSTNAME: postgres-backup
POSTGRES_BACKUP_HOST: postgres
POSTGRES_BACKUP_PORT: 5432
## DB/USER/PASSWORD are intentionally left blank here — each consuming stack's own
## compose.yaml overrides these three directly to the same ${POSTGRES_DB}/${POSTGRES_USER}/
## ${POSTGRES_PASSWORD} values its own postgres service already resolves (or, for the
## Komodo/FerretDB stack, the literal "postgres" DB name), instead of duplicating the
## credential into a second Komodo-managed variable. See each stack's compose.yaml.
POSTGRES_BACKUP_DB:
POSTGRES_BACKUP_USER:
POSTGRES_BACKUP_PASSWORD:
## Cron-style schedule string (postgres-backup-local's own scheduler, e.g. "@daily" or "0 3 * * *")
POSTGRES_BACKUP_SCHEDULE: "@daily"
POSTGRES_BACKUP_KEEP_DAYS: 7
POSTGRES_BACKUP_KEEP_WEEKS: 4
POSTGRES_BACKUP_KEEP_MONTHS: 6
