#= Stack Specific Settings
#== Bulwark
BULWARK_HOSTNAME: bulwark
BULWARK_SERVICE_NAME: webmail
## Blank means https://mail.<DOMAIN_NAME>, Stalwart's public URL.
BULWARK_JMAP_SERVER_URL: 
BULWARK_SESSION_SECRET_KEY: [[BULWARK_SESSION_SECRET_KEY]]
## The Authentik application's issuer with NO trailing slash, such as
## https://auth.example.com/application/o/mail
BULWARK_OAUTH_ISSUER_URL: 
BULWARK_OAUTH_CLIENT_ID: [[MAIL_OIDC_CLIENT_ID]]
BULWARK_OAUTH_CLIENT_SECRET: [[MAIL_OIDC_CLIENT_SECRET]]
