#= Stack Specific Settings
#== Crowdsec
CROWDSEC_IMAGE: crowdsecurity/crowdsec
CROWDSEC_VERSION: [[GLOBAL_CROWDSEC_VERSION]]
CROWDSEC_HOSTNAME: crowdsec
CROWDSEC_SERVICE_NAME: crowdsec
CROWDSEC_LAPI_URL: [[GLOBAL_CROWDSEC_LAPI_URL]]
CROWDSEC_AGENT_PASSWORD: 

#== Postgres
POSTGRES_VERSION: [[GLOBAL_CROWDSEC_POSTGRES_VERSION]]
POSTGRES_USER=[[CROWDSEC_POSTGRES_USER]]
POSTGRES_PASSWORD=[[CROWDSEC_POSTGRES_PASSWORD]]
POSTGRES_DB=crowdsec-db