#= Stack Specific Settings
#== Traefik
TRAEFIK_HOSTNAME: traefik
TRAEFIK_EXTRA_COMMAND:  
## CloudFlare
CF_API_EMAIL: [[CF_API_EMAIL]]
CF_DNS_API_TOKEN: [[CF_DNS_API_TOKEN]]
## Let's Encrypt account email for the letsencrypt resolver
LE_EMAIL: [[LE_EMAIL]]
## Crowdsec
CROWDSEC_LAPI_KEY: 
CROWDSEC_LAPI_HOST: [[GLOBAL_CROWDSEC_LAPI_HOST]]
## Authentic
AUTHENTIK_HOST: [[GLOBAL_AUTHENTIK_HOST]]

#== Traefik Certificates and Auth [traefik]
## TLS options for the https and dashboard entrypoints. tls-opts@file sets
## sniStrict, so it needs a real certificate for every hostname served.
TRAEFIK_TLS_OPTIONS: tls-opts@file
## Certificate resolver for the dashboard entrypoint and the default
## certificate store. Blank means none, and Traefik falls back to its own
## self-signed certificate.
TRAEFIK_CERT_RESOLVER: letsencrypt
## Auth middleware chain for this stack's Traefik dashboard router. Blank takes
## the compose default, chain-authentik@file. Set it only to override that.
TRAEFIK_AUTH_CHAIN: 

#== Traefik Certificates and Auth [traefik-bootstrap]
## traefik-bootstrap runs before pk01 and id01 exist, so it has no certificate
## to be strict about and no Authentik to forward to. See
## docs/traefik-bootstrap.md.
TRAEFIK_TLS_OPTIONS: tls-opts-selfsigned@file
TRAEFIK_CERT_RESOLVER: 
TRAEFIK_AUTH_CHAIN: chain-no-auth@file
