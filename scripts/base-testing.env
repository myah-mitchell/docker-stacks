PROXY_NETWORK=proxy
PUID=1000
PGID=1000
TZ=America/Chicago
DOCKER_VOLUMES=/opt/docker/volumes
DOCKER_LOGS=/opt/docker/logs
MEM_LIMIT=2G
MEM_SWAP_LIMIT=2.5G
MEM_RESERVATION=64M
PIDS_LIMIT=200
CPUS_LIMIT=2
RESTART_GRACE=1m
RESTART_MODE=unless-stopped
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
HEALTH_INTERVAL=60s
HEALTH_TIMEOUT=10s
HEALTH_RETRIES=5
HEALTH_START=10s