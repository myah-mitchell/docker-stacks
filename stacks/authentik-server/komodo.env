################################################################
# .env
# When both env_file and environment are set for a service, values set by environment have precedence.
# https://docs.docker.com/compose/environment-variables/envvars-precedence/
#
# CANNOT MIX ARRAYS (KEY: VAL) AND MAPS (KEY=VAL)
# Ex: Cannot have .ENV var as TZ=US and then a var here as DB_ENGINE: sqlite, has to be DB_ENGINE=sqlite
# Otherwise unexpected type map[string]interface {} occurs
# https://github.com/docker/compose/issues/11567
#
################################################################

#= Project Specific Settings
## Name of the project stack
PROJECT_NAME: authentik
## Hostname of server stack runs on
SERVER_NAME: 
## Include a trailing "." if SUB_DOMAIN_NAME field is used. (e.g. "cloud.")
## The dot is part of this value, not added automatically anywhere else — every
## compose.yaml/komodo.env/hostname/URL in this repo builds hostnames by directly
## concatenating "${SUB_DOMAIN_NAME}${DOMAIN_NAME}". To drop the sub-domain entirely
## (e.g. for a public/external hostname), just leave this blank — you'll get
## "example.com", not a stray leading dot ("`.example.com`"). Nothing needs
## conditional logic to strip a dot that was never there.
SUB_DOMAIN_NAME:
## Include domain and TLD. (e.g. "example.com")
DOMAIN_NAME: 

#= Stack Specific Settings
#== Authentik
AUTHENTIK_HOSTNAME: authentik
AUTHENTIK_SERVICE_NAME: auth
AUTHENTIK_DISABLE_STARTUP_ANALYTICS: true
AUTHENTIK_DISABLE_UPDATE_CHECK: false
AUTHENTIK_ERROR_REPORTING__ENABLED: false
AUTHENTIK_LOG_LEVEL: info
AUTHENTIK_SECRET_KEY: [[AUTHENTIK_SECRET_KEY]]
AUTHENTIK_COOKIE_DOMAIN: ${DOMAIN_NAME}
## Authentik Email
AUTHENTIK_EMAIL__HOST: [[GLOBAL_EMAIL_HOST]]
AUTHENTIK_EMAIL__PORT: [[GLOBAL_EMAIL_PORT]]
AUTHENTIK_EMAIL__USERNAME: [[GLOBAL_EMAIL_USER]]
AUTHENTIK_EMAIL__PASSWORD: [[GLOBAL_EMAIL_PASS]]
AUTHENTIK_EMAIL__USE_TLS: [[GLOBAL_EMAIL_TLS]]
AUTHENTIK_EMAIL__USE_SSL: [[GLOBAL_EMAIL_SSL]]
AUTHENTIK_EMAIL__TIMEOUT: 10
AUTHENTIK_EMAIL__FROM: [[GLOBAL_EMAIL_FROM]]

#== Postgres
POSTGRES_USER: [[AUTHENTIK_POSTGRES_USER]]
POSTGRES_PASSWORD: [[AUTHENTIK_POSTGRES_PASSWORD]]
POSTGRES_DB: authentik-db
POSTGRES_HOSTNAME: postgres

#== Postgres Backup
POSTGRES_BACKUP_HOSTNAME: postgres-backup
POSTGRES_BACKUP_HOST: postgres
POSTGRES_BACKUP_PORT: 5432
## DB/USER/PASSWORD are intentionally left blank here — each consuming stack's own
## compose.yaml overrides these three directly to the same ${POSTGRES_DB}/${POSTGRES_USER}/
## ${POSTGRES_PASSWORD} values its own postgres service already resolves (or, for the
## Komodo/FerretDB stack, the literal "postgres" DB name), instead of duplicating the
## credential into a second Komodo-managed variable. See each stack's compose.yaml.
POSTGRES_BACKUP_DB:
POSTGRES_BACKUP_USER:
POSTGRES_BACKUP_PASSWORD:
## Cron-style schedule string (postgres-backup-local's own scheduler, e.g. "@daily" or "0 3 * * *")
POSTGRES_BACKUP_SCHEDULE: "@daily"
POSTGRES_BACKUP_KEEP_DAYS: 7
POSTGRES_BACKUP_KEEP_WEEKS: 4
POSTGRES_BACKUP_KEEP_MONTHS: 6

#== Redis
REDIS_HOSTNAME: redis

#== Geoipupdate
GEOIPUPDATE_HOSTNAME: geoipupdate
GEOIPUPDATE_EDITION_IDS: "GeoLite2-City GeoLite2-ASN"
GEOIPUPDATE_FREQUENCY: 8
GEOIPUPDATE_ACCOUNT_ID: [[GLOBAL_GEOIPUPDATE_ACCOUNT_ID]]
GEOIPUPDATE_LICENSE_KEY: [[GLOBAL_GEOIPUPDATE_LICENSE_KEY]]

#== Socket-Proxy
SOCKET_PROXY_HOSTNAME: socket-proxy

#= Global Settings
#== Environment Settings
PUID: [[GLOBAL_PUID]]
PGID: [[GLOBAL_PGID]]
TZ: [[GLOBAL_TZ]]
DOCKER_VOLUMES: [[GLOBAL_DOCKER_VOLUMES]]
DOCKER_LOGS: [[GLOBAL_DOCKER_LOGS]]
PROXY_NETWORK: [[GLOBAL_PROXY_NETWORK]]

#== Resource Limits
MEM_LIMIT: [[GLOBAL_MEM_LIMIT]]
MEM_SWAP_LIMIT: [[GLOBAL_MEM_SWAP_LIMIT]]
MEM_RESERVATION: [[GLOBAL_MEM_RESERVATION]]
PIDS_LIMIT: [[GLOBAL_PIDS_LIMIT]]
CPUS_LIMIT: [[GLOBAL_CPUS_LIMIT]]

#== Running Settings
RESTART_GRACE: [[GLOBAL_RESTART_GRACE]]
RESTART_MODE: [[GLOBAL_RESTART_MODE]]

#== Logging Settings
LOG_MAX_SIZE: [[GLOBAL_LOG_MAX_SIZE]]
LOG_MAX_FILE: [[GLOBAL_LOG_MAX_FILE]]

#== Health Check Settings
HEALTH_INTERVAL: [[GLOBAL_HEALTH_INTERVAL]]
HEALTH_TIMEOUT: [[GLOBAL_HEALTH_TIMEOUT]]
HEALTH_RETRIES: [[GLOBAL_HEALTH_RETRIES]]
HEALTH_START: [[GLOBAL_HEALTH_START]]
