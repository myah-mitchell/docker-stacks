#= Stack Specific Settings
#== VMAgent
VMAGENT_HOSTNAME: vmagent
#== VMAgent [vmagent-host, vmagent-system]
## Node-Exporter. Only the user name lives here. Its password is generated per
## host by ansible's monitoring role and mounted in as a file, so there is
## nothing for Komodo to hold.
NODE_EXPORTER_USER: node-exporter-user

#== VMAuth
VMAUTH_USER: [[GLOBAL_VMAUTH_USER]]
VMAUTH_PASS: [[GLOBAL_VMAUTH_PASS]]
VMAUTH_HOST: [[GLOBAL_VMAUTH_HOST]]