#= Stack Specific Settings
#== Traefik
TRAEFIK_HOSTNAME: traefik
TRAEFIK_EXTRA_COMMAND:  
## Auth middleware chain for this stack's Traefik dashboard router. Leave blank
## to take whichever default that stack's compose.yaml sets: chain-authentik@file
## for a normal deploy, chain-no-auth@file for traefik-bootstrap, which runs
## before Authentik exists. Set it only to override that default.
TRAEFIK_AUTH_CHAIN: 
## CloudFlare
CF_API_EMAIL: [[CF_API_EMAIL]]
CF_DNS_API_TOKEN: [[CF_DNS_API_TOKEN]]
## Let's Encrypt account email for the letsencrypt resolver
LE_EMAIL: [[LE_EMAIL]]
## Crowdsec
CROWDSEC_LAPI_KEY: 
CROWDSEC_LAPI_HOST: [[GLOBAL_CROWDSEC_LAPI_HOST]]
## Authentic
AUTHENTIK_HOST: [[GLOBAL_AUTHENTIK_HOST]]