# mailrise.conf — copy to mailrise.conf and fill in the ntfy token.
#
# Mailrise routes by recipient address. A key with no domain, like "backups",
# matches only <key>@mailrise.xyz, mailrise's own placeholder domain, and mail
# to any other domain is refused. Point PBS/PVE notification targets at the
# matching address below.

listen:
  smtp:
    hostname: 0.0.0.0
    port: 8025

configs:
  # PBS and PVE notifications -> to: backups@mailrise.xyz
  backups:
    urls:
      - "ntfy://REPLACE_WITH_NTFY_TOKEN@ntfy/alerts-backups"

  # Everything else -> to: infra@mailrise.xyz. vmalert's Alertmanager webhook
  # can hit ntfy's own HTTP API directly instead of going through mailrise; see
  # Phase 2's vmalert -> ntfy wiring.
  infra:
    urls:
      - "ntfy://REPLACE_WITH_NTFY_TOKEN@ntfy/alerts-infra"
