*/*-data/*
*/*-logs/*
*/.env
.env

# config/ is never gitignored — it must never hold real secrets by convention.
# Any container whose real config would contain a credential (e.g. mailrise's
# ntfy token, cloudflared's tunnel credentials.json) keeps the real file in
# secrets/ instead (see each container's stack-README), never in config/.
containers/*/secrets/*
!containers/*/secrets/.gitkeep