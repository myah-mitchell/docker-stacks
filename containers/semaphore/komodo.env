#= Stack Specific Settings
#== Traefik
## Auth middleware chain for this stack's Traefik router. Leave blank for the
## real chain-authentik@file default (set in compose.yaml via
## ${TRAEFIK_AUTH_CHAIN:-chain-authentik@file}); override to chain-no-auth@file
## only for a bootstrap-phase deploy, before Authentik exists.
TRAEFIK_AUTH_CHAIN: 
#== Semaphore
SEMAPHORE_HOSTNAME: semaphore
SEMAPHORE_SERVICE_NAME: semaphore
SEMAPHORE_ADMIN_USER: [[SEMAPHORE_ADMIN_USER]]
SEMAPHORE_ADMIN_NAME: [[SEMAPHORE_ADMIN_NAME]]
SEMAPHORE_ADMIN_EMAIL: [[SEMAPHORE_ADMIN_EMAIL]]
SEMAPHORE_ADMIN_PASSWORD: [[SEMAPHORE_ADMIN_PASSWORD]]
SEMAPHORE_COOKIE_HASH: [[SEMAPHORE_COOKIE_HASH]]
SEMAPHORE_COOKIE_ENCRYPTION: [[SEMAPHORE_COOKIE_ENCRYPTION]]
SEMAPHORE_ACCESS_KEY_ENCRYPTION: [[SEMAPHORE_ACCESS_KEY_ENCRYPTION]]

#== Postgres
POSTGRES_USER: [[SEMAPHORE_POSTGRES_USER]]
POSTGRES_PASSWORD: [[SEMAPHORE_POSTGRES_PASSWORD]]
POSTGRES_DB: semaphore-db
