#= Stack Specific Settings
#== Redis
REDIS_HOSTNAME: redis
#== Redis [redis-public, redis-replica]
REDIS_PASSWORD: 
## Turns on the Traefik Redis provider, reading this stack's own Redis. Only
## stacks with a master or replica get this key, so every other Traefik leaves
## the provider off.
TRAEFIK_REDIS_ENDPOINTS: redis:6379
#== Redis [redis-replica]
REDIS_SERVER: 