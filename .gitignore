*/*-data/*
*/*-logs/*
*/.env
.env

# Real per-deployment config (may contain secrets, e.g. mailrise.conf's ntfy token,
# cloudflared's tunnel credentials.json) — only the committed *.example stays in git.
containers/*/config/*
!containers/*/config/*.example

# Real per-deployment secrets on disk (e.g. step-ca's CA password file) — never committed.
containers/*/secrets/*
!containers/*/secrets/.gitkeep